# Database Configuration (Docker local DB or Supabase pooled connection)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&sslaccept=accept_invalid_certs"

# Google Gemini API Key (If used)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-google-api-key"

# Agent Kernel Config
AK_EXECUTION__MODE="stream"
AK_MULTIMODAL__ENABLED="false"
AK_MULTIMODAL__STORAGE_TYPE="in_memory"

# LLM Provider Configuration
LLM_PROVIDER="groq"
GROQ_API_KEY="your-groq-api-key"

# Telegram Integration
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# Supabase Storage Configuration
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
